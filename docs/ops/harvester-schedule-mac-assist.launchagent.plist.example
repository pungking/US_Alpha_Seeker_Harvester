<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.us-alpha-seeker.harvester-schedule-assist</string>
	<key>ProgramArguments</key>
	<array>
		<string>/REPLACE_WITH_EXISTING_PYTHON</string>
		<string>/REPLACE_WITH_CHECKOUT/scripts/dispatch_harvester_daily_slot.py</string>
		<string>--config</string>
		<string>/REPLACE_WITH_PRIVATE_CONFIG.json</string>
		<string>--receipt-dir</string>
		<string>/REPLACE_WITH_PRIVATE_RECEIPT_DIRECTORY</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>7</integer>
			<key>Minute</key>
			<integer>13</integer>
			<key>Weekday</key>
			<integer>2</integer>
		</dict>
